<Window
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Height="130"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Title="CountdownOverlay"
    Topmost="True"
    Width="150"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    d:DataContext="{d:DesignInstance local:CountdownWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="130"
    d:DesignWidth="150"
    mc:Ignorable="d"
    x:Class="SnapClicker.Views.Windows.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SnapClicker.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="0,0,0,0"
        Padding="14,12">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <!-- Countdown Number + Icon -->
                <RowDefinition Height="Auto" />
                <!-- Subtitle -->
                <RowDefinition Height="Auto" />
                <!-- Esc cancel -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Countdown Digit with Timer Icon -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    FontSize="24"
                    Margin="0,0,8,0"
                    Symbol="Timer20"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontSize="32"
                    FontTypography="Title"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ViewModel.CountdownText}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status Subtext -->
            <ui:TextBlock
                FontTypography="BodyStrong"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Text="{Binding ViewModel.SubText}"
                TextAlignment="Center" />

            <!-- Esc Hint -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,4,0"
                    Symbol="DismissCircle16"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Esc to cancel"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
