<Window
    AllowsTransparency="True"
    Background="#40000000"
    Cursor="Cross"
    Focusable="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Title="RegionSelectorWindow"
    Topmost="True"
    WindowStyle="None"
    x:Class="SnapClicker.Views.Windows.RegionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="OverlayCanvas">
            <!-- Instruction Header -->
            <Border
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Canvas.Left="0"
                Canvas.Top="40"
                CornerRadius="8"
                HorizontalAlignment="Center"
                Padding="16,8"
                x:Name="InstructionBorder">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        FontSize="16"
                        Margin="0,0,8,0"
                        Symbol="SelectObject20"
                        VerticalAlignment="Center" />
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Text="Click and drag to select a screen region. Press ESC to cancel."
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Selection Box -->
            <Border
                Background="#330078D4"
                BorderBrush="#0078D4"
                BorderThickness="2"
                CornerRadius="3"
                Visibility="Collapsed"
                x:Name="SelectionBorder" />

            <!-- Dimension & Coordinate Badge -->
            <Border
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                Visibility="Collapsed"
                x:Name="InfoBadge">
                <ui:TextBlock
                    FontTypography="Caption"
                    FontWeight="SemiBold"
                    x:Name="InfoText" />
            </Border>
        </Canvas>
    </Grid>
</Window>
