<Window
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Height="46"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Title="RecordInfoWindow"
    Topmost="True"
    Width="480"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    d:DataContext="{d:DesignInstance local:RecordWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="46"
    d:DesignWidth="480"
    mc:Ignorable="d"
    x:Class="SnapClicker.Views.Windows.RecordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SnapClicker.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="14,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Mouse coordinates -->
                <ColumnDefinition Width="Auto" />
                <!-- Separator -->
                <ColumnDefinition Width="20" />
                <!-- Captured Action -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Mouse Coordinates -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    FontSize="16"
                    Margin="0,0,6,0"
                    Symbol="DesktopCursor20"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Margin="0,0,4,0"
                    Text="X:"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontTypography="Body"
                    Margin="0,0,12,0"
                    Text="{Binding ViewModel.CursorX}"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Margin="0,0,4,0"
                    Text="Y:"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontTypography="Body"
                    Text="{Binding ViewModel.CursorY}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Vertical Separator -->
            <Rectangle
                Fill="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                Grid.Column="1"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="1" />

            <!-- Captured Action Log -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    FontSize="16"
                    Margin="0,0,6,0"
                    Symbol="Cursor20"
                    VerticalAlignment="Center"
                    Visibility="{Binding ViewModel.Key, Mode=OneWay, Converter={StaticResource KeyToVisibilityConverter}, ConverterParameter=true}" />
                <ui:SymbolIcon
                    FontSize="16"
                    Margin="0,0,6,0"
                    Symbol="Keyboard20"
                    VerticalAlignment="Center"
                    Visibility="{Binding ViewModel.Key, Mode=OneWay, Converter={StaticResource KeyToVisibilityConverter}}" />
                <ui:TextBlock
                    FontTypography="BodyStrong"
                    Margin="0,0,5,0"
                    Text="{Binding ViewModel.Type, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <ui:TextBlock
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    Text="captured"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
